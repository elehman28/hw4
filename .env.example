# Copy this file to .env (in the hw4/ folder) and fill in your own values.
# Never commit .env; it is git-ignored.

# Portkey gateway key (sent as the x-portkey-api-key header to https://api.portkey.ai/v1)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional settings (these are the defaults)
CC_CHAT_MODEL=gpt-5.6-luna
CC_REASONING_EFFORT=none
